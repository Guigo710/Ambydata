# Regras comuns ao monorepo. As regras de cada projeto ficam em
# backend/.gitignore e frontend/.gitignore.

# Sistema operacional e IDE
.DS_Store
Thumbs.db
.idea/

# Variáveis de ambiente locais (nunca versionar credenciais). Inclui
# .env.production e .env.development de propósito: valores de deploy ficam
# no painel da Vercel e do Render; só o .env.example é versionado.
.env
.env.*
!.env.example
